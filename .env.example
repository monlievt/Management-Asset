# SIM-TIK Enterprise Environment Configuration
NODE_ENV=development
PORT=5001

# Security & Sessions
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key_in_production
SESSION_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_PATH=./data/simtik.db

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
